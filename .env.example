# Servidor
HOST=0.0.0.0
PORT=8000
FLASK_DEBUG=false

# Seguridad (activar para demos públicas)
AUTH_ENABLED=false
API_KEY=cambia-esta-clave

# Límites de upload
MAX_VIDEO_MB=200

# Modelos (rutas relativas al root del repo o absolutas)
# yolov5n = más rápido en CPU; yolov5s = más preciso
YOLO_MODEL=yolov5s
YOLO_WEIGHTS=yolov5s.pt

# Patentes AR (recomendado): JustAnotherAlpr ya entrenado — NO hace falta el RAR
PLATE_BACKEND=darknet_ar
DARKNET_CFG=third_party/JustAnotherAlpr/nn/license-plate/license-plate.cfg
DARKNET_WEIGHTS=third_party/JustAnotherAlpr/nn/license-plate/license-plate.weights
# Alternativa TF legacy:
# PLATE_BACKEND=tf
# PLATE_WEIGHTS=main/services/custom-anchors

# OCR AR (ConvALPR). Alternativa: OCR_BACKEND=keras_h5
OCR_BACKEND=convalpr
CONVALPR_OCR_DIR=third_party/ConvALPR/alpr/models/ocr/m3_1.3M_CPU
OCR_MODEL_PATH=main/services/model.h5

# Umbrales (darknet_ar suele ir mejor con day~0.45-0.55)
PLATE_IOU=0.45
PLATE_SCORE=0.25
DAY_SCORE_THRESHOLD=0.50
NIGHT_SCORE_THRESHOLD=0.30
OCR_MIN_CONFIDENCE=0.35
ROI_PAD_RATIO=0.12

# Tracking
TRACK_DISTANCE_PX=60
TRACK_MAX_DISAPPEARED=30
VEHICLE_CLASS_IDS=2,3,5,7

# Precisión censo (YOLOv5 COCO — carteles suelen confundirse con bus)
YOLO_CONF=0.45
YOLO_IOU=0.45
YOLO_BUS_CONF=0.60
YOLO_TRUCK_CONF=0.55
VEHICLE_MIN_AREA_RATIO=0.003
VEHICLE_MAX_ASPECT=3.8
TRACK_CONFIRM_FRAMES=2

# Solo para depuración local con GUI (no usar en servidor)
SHOW_PREVIEW=false

# Videos anotados temporales (segundos)
ARTIFACT_TTL_SECONDS=3600

# Velocidad patentes (CPU): subir stride = más rápido / menos frames
PLATE_FRAME_STRIDE=4
PLATE_INFER_SIZE=416
PLATE_MAX_SIDE=960
OCR_SKIP_IF_KNOWN=true

# Velocidad censo YOLOv5 (CPU) — antes infería CADA frame a resolución nativa
VEHICLE_FRAME_STRIDE=3
VEHICLE_MAX_SIDE=960

# Threads (0 = default de la librería). Ej: núcleos físicos (6 en RX 6700 XT PC)
CV2_NUM_THREADS=0
TORCH_NUM_THREADS=0

# Preview en vivo (más liviano = UI más fluida)
LIVE_FRAME_STRIDE=3
LIVE_JPEG_QUALITY=40
LIVE_PREVIEW_WIDTH=640

# Tests / CI: no cargar pesos pesados al importar
# SKIP_MODEL_LOAD=true
